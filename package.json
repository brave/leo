{
  "name": "@brave/nala",
  "version": "1.0.0",
  "description": "Base repo to transform json design tokens from the figma design token plugin via amazon style directory.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brave/leo.git"
  },
  "files": [
    "shared",
    "react",
    "web-components",
    "tokens",
    "types",
    "!types/**/*.stories.*",
    "icons",
    "src/scripts/audit-tokens.js",
    "src/scripts/common.js",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md",
    "svelte/components",
    "svelte/svelteDirectives",
    "svelte/types",
    "!svelte/**/*.stories.*"
  ],
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "7.29.7",
