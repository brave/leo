    "svgo": "4.0.2",
    "ts-jest": "29.1.2",
    "tsx": "4.21.0",
    "undici": "7.29.0",
    "vite": "6.4.3",
    "@sveltejs/package": "2.5.8",
    "svelte": "5.56.1",
    "@storybook/test": "8.6.15",
    "svelte-preprocess": "6.0.3",
    "tailwindcss": "3.4.19",
    "tslib": "2.8.1"
  },
  "peerDependencies": {
    "@material/material-color-utilities": ">= 0.2.7",
    "react": ">= 16.0.0",
    "typescript": ">= 4.7.0",
    "svelte": "^5.0.0",
    "tailwindcss": "3.4.19"
  },
  "peerDependenciesMeta": {
    "@material/material-color-utilities": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "scripts": {
    "format": "prettier ./ --write",
    "format-diff": "prettier ./ --list-different",
    "prepare": "pnpm run build",
    "build": "pnpm run transform-tokens && pnpm run skiafy-icons && pnpm run android-icons && pnpm run package-svelte && rollup -c rollup.config.js",
    "package-svelte": "svelte-package -i ./src -o ./svelte --tsconfig ./tsconfig-svelte-package.json",
    "dev": "rollup -c rollup.config.js --watch",
    "update-icons": "tsx ./src/scripts/update-icons.ts",
    "skiafy-icons": "tsx ./src/scripts/gen-skia-icons.ts",
    "android-icons": "tsx ./src/scripts/gen-android-icons.ts",
    "check": "svelte-check --compiler-warnings a11y-click-events-have-key-events:ignore,a11y-no-static-element-interactions:ignore && node ./src/scripts/audit-events.js",
    "transform-tokens": "tsx ./src/tokens/transformTokens.ts && tsc -p ./tsconfig-tokens.json",
    "test": "jest tests --coverage=false",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "audit_deps": "node scripts/audit_deps.js",
    "changelog": "tsx ./src/scripts/gen-changelog.ts"
  },
  "bin": {
    "leo-check": "./src/scripts/audit-tokens.js"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.27.0+sha512.ad12821463bb143295f1fa3ecde77a6b9b97a7990386da800ff57bffc3964dc64b7b1c7559d5dbe5c337aea659ed9c8937d4370bd198ca2009bc6fa0249808e7"
}
