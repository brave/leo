    "lodash": "4.18.1",
    "postcss": "8.5.14",
    "postcss-js": "4.1.0",
    "postcss-sort-media-queries": "4.4.1",
    "prettier": "3.8.3",
    "prettier-plugin-svelte": "3.5.1",
